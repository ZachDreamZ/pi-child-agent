# ────────┬────────────────────────────────────────────────────────
# Variable │ Description
# ────────┼────────────────────────────────────────────────────────
# NPM_TOKEN │ npm access token (automation) — used by `npm run publish:npm`
#            │ Create one at https://www.npmjs.com/settings/<you>/tokens
#            │ Required scopes: "Automation" (no 2FA per-publish) or "Publish"
#            │
# GH_TOKEN   │ GitHub personal access token — used for pushing/releasing
#            │ Create one at https://github.com/settings/tokens

NPM_TOKEN=
GH_TOKEN=
