# Pi Child Agent - Environment Variables
# Copy this file to .env and fill in your tokens.
# NEVER commit this file to version control (.gitignore already ignores .env).

# GitHub token for pushing/releasing (optional, used by scripts)
GH_TOKEN=your_github_token_here

# NPM token for publishing to npm (optional, for future use)
NPM_TOKEN=your_npm_token_here
