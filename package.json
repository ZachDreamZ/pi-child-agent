{
  "name": "pi-child-agent",
  "version": "0.1.0",
  "description": "Pi extension for isolated parent-child agent workflows",
  "main": "index.ts",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "doctor": "tsx scripts/doctor.ts",
    "install:pi": "bash scripts/install.sh",
    "install:win": "powershell -ExecutionPolicy Bypass -File scripts/install.ps1",
    "uninstall": "bash scripts/uninstall.sh",
    "update": "bash scripts/update.sh",
    "validate:tools": "tsx scripts/validate-tools.ts",
    "test": "tsx tests/test-extension.ts && tsx tests/windows-native-smoke.ts && tsx tests/phase2-hardening.ts && tsx tests/crash-recovery.ts",
    "test:container": "tsx tests/container-smoke.ts",
    "test:crash": "tsx tests/crash-recovery.ts",
    "test:phase2": "tsx tests/phase2-hardening.ts",
    "test:windows-native": "tsx tests/windows-native-smoke.ts"
  },
  "dependencies": {
    "tree-kill": "^1.2.2",
    "typebox": "latest"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "tsx": "latest",
    "typescript": "^5.0.0"
  },
  "pi": {
    "extensions": [
      "index.ts"
    ]
  }
}
